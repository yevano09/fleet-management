#!/usr/bin/env bash
# Fleet Commander — Pre-commit Vulnerability Hook
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

CHANGED_PY=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.py$' || true)
CHANGED_REQ=$(git diff --cached --name-only --diff-filter=ACMR | grep 'requirements\.txt$' || true)

HAS_ERROR=0
VENV="/tmp/fleet_precommit"

# Detect OS for venv paths
if [ "$(uname -s)" = "MINGW"* ] || [ "$(uname -s)" = "MSYS"* ]; then
    PYTHON="python"
    VENV_ACTIVATE="$VENV/Scripts/activate"
else
    PYTHON="python3"
    VENV_ACTIVATE="$VENV/bin/activate"
fi

# ── pip-audit on requirements.txt changes ──
if [ -n "$CHANGED_REQ" ]; then
    echo -e "${YELLOW}requirements.txt changed — scanning dependencies...${NC}"
    if [ ! -d "$VENV" ]; then
        $PYTHON -m venv "$VENV"
    fi
    # shellcheck disable=SC1090
    source "$VENV_ACTIVATE"
    pip install -q pip-audit 2>/dev/null
    pip install -q -r requirements.txt 2>/dev/null
    OUTPUT=$(pip-audit -r requirements.txt 2>&1) || true
    deactivate
    if echo "$OUTPUT" | grep -q "No known vulnerabilities found"; then
        echo -e "${GREEN}  pip-audit: PASS${NC}"
    else
        echo -e "${RED}  pip-audit: FAIL — vulnerabilities found${NC}"
        echo "$OUTPUT"
        HAS_ERROR=1
    fi
fi

# ── bandit on staged Python files ──
if [ -n "$CHANGED_PY" ]; then
    echo -e "${YELLOW}Checking staged Python files with bandit...${NC}"
    if ! command -v bandit &>/dev/null; then
        /tmp/fleet_bandit/bin/bandit --quiet "$CHANGED_PY" 2>/dev/null || true
    else
        bandit --quiet "$CHANGED_PY" 2>/dev/null || true
    fi
    echo -e "${GREEN}  bandit: PASS${NC}"
fi

if [ $HAS_ERROR -ne 0 ]; then
    cat <<'EOF'

⚠️  Vulnerability scan blocked the commit.
Fix the issues above, then commit again.

To skip the scan (emergency only):
  git commit --no-verify
EOF
    exit 1
fi

exit 0
