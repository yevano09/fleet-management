FROM python:3.12-slim

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG http_proxy
ARG https_proxy

WORKDIR /app

RUN apt-get update && apt-get upgrade -y && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir pytest requests httpx

COPY tests/ ./tests/
COPY requirements.txt .
COPY .env.example .env

ENV PYTHONPATH=/app
ENV BASE_URL=http://backend:8000

CMD ["pytest", "tests/test_e2e.py", "-v", "--tb=short"]
