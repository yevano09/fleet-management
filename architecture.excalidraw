      "roundness": null,
      "boundElements": [],
      "updated": 1779468834483,
      "link": null,
      "locked": false,
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "🔧 Production Changes:\n- PostgreSQL with RDS\n- Backend auto-scaled\n- MQTT cluster / managed\n- S3 for firmware files\n- Prometheus retention 30d\n- Alertmanager + pager\n- Startup: health check gates\n  between all services",
      "autoResize": true,
      "lineHeight": 1.2820512820512822
    },
