    {
      "id": "demo-note",
      "type": "text",
      "x": 80,
      "y": 440,
      "width": 180,
      "height": 150,
      "text": "⚠️ Demo Notes:\n- All in Docker Compose\n- Single machine (WSL)\n- SQLite (no Postgres needed)\n- 5 simulated devices\n- 20% OTA failure rate\n- Auto-rollback visible in ~30s\n- Simulator waits for backend healthy\n  (fixes MQTT race on startup)",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#2b8a3e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "version": 2,
      "versionNonce": 67863609,
      "index": "aV",
      "isDeleted": false,
      "strokeStyle": "solid",
      "angle": 0,
      "seed": 1,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1779468834483,
      "link": null,
      "locked": false,
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "⚠️ Demo Notes:\n- All in Docker Compose\n- Single machine (WSL)\n- SQLite (no Postgres needed)\n- 5 simulated devices\n- 20% OTA failure rate\n- Auto-rollback visible in ~30s\n- Simulator waits for backend healthy\n  (fixes MQTT race on startup)",
      "autoResize": true,
      "lineHeight": 1.2820512820512822
    },
    {
      "id": "prod-note",
      "type": "text",
      "x": 840,
      "y": 440,
      "width": 180,
      "height": 150,
      "text": "🔧 Production Changes:\n- PostgreSQL with RDS\n- Backend auto-scaled\n- MQTT cluster / managed\n- S3 for firmware files\n- Prometheus retention 30d\n- Alertmanager + pager\n- Startup: health check gates\n  between all services",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "version": 2,
      "versionNonce": 931706839,
