# Fleet Commander - Environment Configuration
# Copy this file to .env and adjust values for your deployment.
# NEVER commit a real .env.

# ── Auth mode (P0 UC-23) ─────────────────────────────────────────────────────
# open   → legacy demo behaviour: unauthenticated REST, anonymous MQTT.
#          Default ONLY when AUTH_MODE is unset AND DATABASE_URL is sqlite.
# strict → REQUIRED for --profile production. RBAC enforced, default secrets
#          refused at startup, docs disabled via DOCS_ENABLED=false, firmware
#          downloads require short-lived HMAC tokens.
AUTH_MODE=open

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/fleet.db
# Production (async driver REQUIRED — postgresql+psycopg2 will NOT work):
# DATABASE_URL=postgresql+asyncpg://fleet:fleetpass@postgres:5432/fleet

# ── Secrets (must be non-default in AUTH_MODE=strict) ───────────────────────
JWT_SECRET_KEY=change-me-to-a-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminadmin

# ── MQTT Broker ─────────────────────────────────────────────────────────────
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# P0 UC-24: mutual TLS (production profile)
MQTT_TLS_ENABLED=false
MQTT_CA_CERT=/app/certs/ca.crt
MQTT_CLIENT_CERT=/app/certs/fleet-backend.crt
MQTT_CLIENT_KEY=/app/certs/fleet-backend.key
# Regenerate all PKI material with: bash scripts/gen-mqtt-pki.sh 5
# After revoking a cert: bash scripts/reload-broker.sh

# ── Docs / OpenAPI ──────────────────────────────────────────────────────────
DOCS_ENABLED=true

# ── Application ─────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ── OTA ─────────────────────────────────────────────────────────────────────
OTA_TIMEOUT_SECONDS=120
FIRMWARE_STORAGE_PATH=./firmware
MAX_RETRY_COUNT=3
# External URL that devices use to download firmware (use host LAN IP for ESP32 on same network)
OTA_FIRMWARE_BASE_URL=http://localhost:8000

# ── Prometheus ──────────────────────────────────────────────────────────────
PROMETHEUS_MULTIPROC_DIR=/tmp

# ── Google OAuth (dashboard authentication; optional — API keys cover CLI/E2E)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# ── Device Simulator ────────────────────────────────────────────────────────
SIMULATOR_DEVICE_COUNT=5
SIMULATOR_HEARTBEAT_INTERVAL=10
# Production TLS mode: pin ids to the generated cert CNs:
# SIMULATOR_DEVICE_IDS=sim-001,sim-002,sim-003,sim-004,sim-005

# ── Automation API key (used by run_agents.py / agents.tools in strict mode).
# Mint one via POST /admin/api-keys and paste the fck_ secret here.
FLEET_API_KEY=

# ═══ Session 5+ Features ═══════════════════════════════════════════════════

# Feature 1: Telemetry retention
TELEMETRY_RETENTION_DAYS=30

# Feature 2: Geofencing
GEOFENCE_CHECK_INTERVAL_SECONDS=30

# Feature 4: Scheduled OTA
OTA_SCHEDULER_INTERVAL_SECONDS=30

# Feature 5: Offline command queue
COMMAND_QUEUE_TTL_SECONDS=86400
COMMAND_QUEUE_FLUSH_INTERVAL_SECONDS=15

# Feature 6: Audit log retention
AUDIT_LOG_RETENTION_DAYS=90

# Feature 8: Firmware signing (Ed25519 PEM keys, optional)
# Generate with: python -c "from app.firmware_signing import generate_keypair; priv,pub=generate_keypair(); print(priv); print(pub)"
FIRMWARE_SIGNING_PRIVATE_KEY=
FIRMWARE_SIGNING_PUBLIC_KEY=
FIRMWARE_REQUIRE_SIGNATURE=false

# Feature 10: Real spot prices (provider: mock, iex, entsoe, api)
SPOT_PRICE_PROVIDER=mock
SPOT_PRICE_URL=
SPOT_PRICE_API_KEY=

# Feature 12: RBAC default role for new OAuth users (user, operator, viewer, fleet_manager)
DEFAULT_USER_ROLE=viewer

# V2G battery settings
BATTERY_REPLACEMENT_COST_DOLLARS=35000
BATTERY_CAPACITY_KWH=60
