    },
    {
      "id": "api-dash-text",
      "type": "text",
      "x": 50,
      "y": 870,
      "width": 680,
      "height": 30,
      "text": "Dashboard Router \u2014 GET / \u2192 returns fleet-ui dashboard (Jinja2 HTML + HTMX auto-refresh every 5s, agent panels every 30s)",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#2b8a3e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
