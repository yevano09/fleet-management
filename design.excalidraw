    {
      "id": "er-device-fields",
      "type": "text",
      "x": 840,
      "y": 160,
      "width": 270,
      "height": 145,
      "text": "\u2514\u2500 PK id: UUID\n\u2514\u2500 name: VARCHAR (unique)\n\u2514\u2500 firmware_version: VARCHAR\n\u2514\u2500 status: ENUM (online|offline)\n\u2514\u2500 signal_strength: INT\n\u2514\u2500 last_seen: DATETIME\n\u2514\u2500 uptime_percentage: FLOAT\n\u2514\u2500 ip_address: VARCHAR\n\u2514\u2500 previous_firmware_version?\n\u2514\u2500 current_ota_id?",
