    },
    {
      "id": "api-device-router",
      "type": "rectangle",
      "x": 40,
      "y": 490,
      "width": 340,
      "height": 180,
      "strokeColor": "#6741d9",
      "backgroundColor": "#f3f0ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roundness": { "type": 3 },
