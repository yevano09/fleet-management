    {
      "id": "er-legend",
      "type": "text",
      "x": 820,
      "y": 580,
      "width": 400,
      "height": 65,
      "text": "Relationships:\n\u2022 Device 1\u2014\u20140..* OtaDeployment (one device has many OTA attempts)\n\u2022 Firmware 1\u2014\u20140..* OtaDeployment (one firmware deployed many times)\n\u2022 Device.current_ota_id \u2192 OtaDeployment.id (active deployment reference)",
      "fontSize": 11,
