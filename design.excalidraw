    },
    {
      "id": "api-device-title",
      "type": "text",
      "x": 60,
      "y": 500,
      "width": 150,
      "height": 25,
      "text": "Device Router (prefix: /devices)",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#6741d9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100
    },
    {
      "id": "api-device-endpoints",
      "type": "text",
      "x": 55,
      "y": 530,
      "width": 310,
      "height": 130,
      "text": "POST /register\n  Body: {name, firmware_version, ip_address}\n→ 201: {device_id, name, status}\n  Notes: Auto-registers or re-activates\n\nPOST /{id}/heartbeat\n  Body: {uptime_percentage, signal_strength}\n→ 200: {status: \"ok\", last_seen}\n\nGET /\n  Query: ?status=online|offline\n→ 200: {devices: [...], total: N}",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100
    },
    {
      "id": "api-ota-router",
      "type": "rectangle",
      "x": 400,
      "y": 490,
      "width": 340,
      "height": 180,
      "strokeColor": "#c92a2a",
      "backgroundColor": "#fff5f5",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roundness": { "type": 3 },
      "roughness": 0,
      "opacity": 100
    },
    {
      "id": "api-ota-title",
      "type": "text",
      "x": 420,
      "y": 500,
      "width": 130,
      "height": 25,
      "text": "OTA Router (prefix: /ota)",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100
    },
    {
      "id": "api-ota-endpoints",
      "type": "text",
      "x": 415,
      "y": 530,
      "width": 310,
      "height": 130,
      "text": "POST /upload\n  Form: version + file (binary)\n→ 200: {id, version, sha256_hash, file_size}\n  Action: Saves binary, computes SHA256\n\nPOST /trigger\n  Body: {firmware_id, device_ids|all_devices}\n→ 200: {deployment_ids: [...], message}\n  Action: Publishes MQTT command per device\n\nGET /status\n→ 200: {deployments: [...], counts}\n\nGET /firmware\n→ 200: [{id, version, sha256_hash, ...}]",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100
    },
    {
      "id": "api-dash-router",
      "type": "rectangle",
      "x": 40,
      "y": 690,
      "width": 700,
      "height": 50,
      "strokeColor": "#2b8a3e",
      "backgroundColor": "#ebfbee",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roundness": { "type": 3 },
      "roughness": 0,
      "opacity": 100
    },
    {
      "id": "api-dash-text",
      "type": "text",
      "x": 50,
      "y": 700,
      "width": 680,
      "height": 30,
      "text": "Dashboard Router — GET / → returns fleet-ui dashboard (Jinja2 HTML template with HTMX for live refresh every 5s)",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#2b8a3e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100
    },
    {
      "id": "section4-title",
      "type": "text",
      "x": 820,
      "y": 660,
      "width": 380,
      "height": 30,
      "text": "4. MQTT Topic Architecture",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100
    },
    {
      "id": "mqtt-tree",
      "type": "rectangle",
      "x": 820,
      "y": 700,
      "width": 670,
      "height": 260,
      "strokeColor": "#e67700",
      "backgroundColor": "#fff9db",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roundness": { "type": 3 },
      "roughness": 0,
      "opacity": 100
    },
    {
      "id": "mqtt-tree-text",
      "type": "text",
      "x": 840,
      "y": 715,
      "width": 630,
      "height": 230,
      "text": "iot/fleet/\n├── register                          ← Device publishes on first connect\n│   Payload: {name, firmware_version, ip_address}\n│\n├── {device_id}/\n│   ├── heartbeat                     ← Device publishes every 10s\n│   │   Payload: {uptime_percentage, signal_strength}\n│   │\n│   ├── command/\n│   │   ├── ota                       ← Backend publishes OTA instruction\n│   │   │   Payload: {firmware_url, sha256_hash, timestamp}\n│   │   └── config                    ← Backend pushes remote config\n│   │       Payload: {config: {...}, timestamp}\n│   │\n│   └── status/\n│       └── ota                       ← Device reports OTA lifecycle\n│           Payload: {status, deployment_id, device_id, timestamp, error?}\n│           States: downloading → applying → verifying → success | hash_mismatch → rollback → rolled_back",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100
    },
    {
      "id": "mqtt-qos",
      "type": "text",
      "x": 820,
      "y": 970,
      "width": 670,
      "height": 40,
      "text": "All topic subscriptions and publications use QoS 1 (at-least-once delivery). The backend subscribes to iot/fleet/+/status/ota, iot/fleet/+/heartbeat, and iot/fleet/register on connect.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100
    },
    {
      "id": "section5-title",
      "type": "text",
      "x": 40,
      "y": 780,
      "width": 400,
      "height": 30,
      "text": "5. OTA State Machine (Design Details)",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
