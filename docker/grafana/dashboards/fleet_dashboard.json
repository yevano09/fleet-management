{
  "title": "Fleet Commander Overview",
  "uid": "fleet-commander-overview",
  "version": 1,
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Active Devices",
      "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
      "targets": [
        {
          "expr": "fleet_active_devices",
          "legendFormat": "Online",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [{"value": 0, "color": "red"}, {"value": 1, "color": "green"}]}
        }
      }
    },
    {
      "id": 2,
      "title": "Total Devices",
      "type": "stat",
      "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
      "targets": [
        {
          "expr": "fleet_total_devices",
          "legendFormat": "Total",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ]
    },
    {
      "id": 3,
      "title": "OTA In Progress",
      "type": "stat",
      "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
      "targets": [
        {
          "expr": "fleet_ota_in_progress",
          "legendFormat": "In Progress",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [{"value": 0, "color": "green"}, {"value": 1, "color": "orange"}, {"value": 5, "color": "red"}]}
        }
      }
    },
    {
      "id": 4,
      "title": "OTA Success Rate",
      "type": "stat",
      "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
      "targets": [
        {
          "expr": "rate(fleet_ota_deployments_total{status=\"success\"}[5m]) / rate(fleet_ota_deployments_total[5m]) * 100",
          "legendFormat": "Success Rate",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [{"value": 0, "color": "red"}, {"value": 50, "color": "orange"}, {"value": 80, "color": "green"}]}
        }
      }
    },
    {
      "id": 5,
      "title": "API Request Latency (P95)",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 4, "w": 8, "h": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(fleet_api_request_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95 Latency",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 6,
      "title": "OTA Deployments by Status",
      "type": "piechart",
      "gridPos": {"x": 8, "y": 4, "w": 8, "h": 8},
      "targets": [
        {
          "expr": "fleet_ota_deployments_total",
          "legendFormat": "{{status}}",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ]
    },
    {
      "id": 7,
      "title": "MQTT Message Throughput",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "rate(fleet_mqtt_messages_published_total[5m])",
          "legendFormat": "Published",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        },
        {
          "expr": "rate(fleet_mqtt_messages_received_total[5m])",
          "legendFormat": "Received",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ]
    },
    {
      "id": 8,
      "title": "Online Devices",
      "type": "bargauge",
      "gridPos": {"x": 12, "y": 12, "w": 4, "h": 8},
      "targets": [
        {
          "expr": "fleet_active_devices / fleet_total_devices * 100",
          "legendFormat": "Online %",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent"
        }
      }
    },
    {
      "id": 9,
      "title": "V2G Active Discharges",
      "type": "stat",
      "gridPos": {"x": 0, "y": 20, "w": 4, "h": 4},
      "targets": [
        {
          "expr": "fleet_v2g_active_discharges",
          "legendFormat": "Discharging",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [{"value": 0, "color": "green"}, {"value": 1, "color": "orange"}]}
        }
      }
    },
    {
      "id": 10,
      "title": "Projected V2G Revenue",
      "type": "stat",
      "gridPos": {"x": 4, "y": 20, "w": 4, "h": 4},
      "targets": [
        {
          "expr": "fleet_v2g_projected_revenue_dollars",
          "legendFormat": "Revenue $",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [{"value": 0, "color": "red"}, {"value": 1, "color": "green"}]}
        }
      }
    },
    {
      "id": 11,
      "title": "Battery Degradation Cost",
      "type": "stat",
      "gridPos": {"x": 8, "y": 20, "w": 4, "h": 4},
      "targets": [
        {
          "expr": "fleet_battery_degradation_cost_dollars",
          "legendFormat": "Deg Cost $",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [{"value": 0, "color": "green"}, {"value": 10, "color": "orange"}, {"value": 50, "color": "red"}]}
        }
      }
    },
    {
      "id": 12,
      "title": "Spot Price vs Degradation Cost",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 24, "w": 8, "h": 8},
      "targets": [
        {
          "expr": "fleet_v2g_projected_revenue_dollars",
          "legendFormat": "Revenue",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        },
        {
          "expr": "fleet_battery_degradation_cost_dollars",
          "legendFormat": "Degradation Cost",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      }
    },
    {
      "id": 13,
      "title": "Fleet SOC over Time",
      "type": "timeseries",
      "gridPos": {"x": 8, "y": 24, "w": 8, "h": 8},
      "targets": [
        {
          "expr": "avg by (device) (fleet_device_soc)",
          "legendFormat": "{{device}}",
          "datasource": {"type": "prometheus", "uid": "prometheus"}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    }
  ],
  "schemaVersion": 39
}
